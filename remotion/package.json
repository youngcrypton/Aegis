{
  "name": "remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render:light": "remotion render AegisLaunchLight out/aegis-launch-video-light.mp4 --concurrency=1 --disallow-parallel-encoding",
    "render:teaser": "remotion render AegisLaunchTeaser out/aegis-teaser.mp4 --concurrency=1 --disallow-parallel-encoding",
    "render:square": "remotion render AegisSocialSquare out/aegis-square.mp4",
    "still:teaser": "remotion still AegisLaunchTeaser out/teaser-thumb.png --frame=75",
    "still:square": "remotion still AegisSocialSquare out/square-thumb.png --frame=60",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}